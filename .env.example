# --- heyfilo webhook receiver (@heyfilo/sdk) -------------------------------
# Shared HMAC secret you configure on the heyfilo connection (HMAC auth mode).
HEYFILO_SECRET=

# Persistent, writable dir the SDK downloads heyfilo images into and serves
# LIVE from (no rebuild/redeploy) via the dynamic route
# `app/media/[...path]/route.ts` at /media/<filename>. Resolved against the
# project root; must be OUTSIDE public/, .next/ and out/. If unset, the SDK
# defaults to <projectRoot>/.heyfilo/media.
HEYFILO_MEDIA_DIR=storage/media

# Runtime media storage dir for ADMIN uploads (lib/media). Keep this pointing at
# the SAME directory as HEYFILO_MEDIA_DIR so admin- and heyfilo-uploaded images
# are served by the same /media route. If unset, defaults to
# <projectRoot>/storage/media.
MEDIA_STORAGE_DIR=
