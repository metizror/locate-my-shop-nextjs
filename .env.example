# Runtime media storage directory for images received from heyfilo (and admin
# uploads). Files written here are served LIVE by the dynamic route
# `app/media/[...path]/route.ts` at /media/<filename> — no rebuild/redeploy.
# Must be a persistent, writable path OUTSIDE public/, .next/ and out/.
# If unset, defaults to <projectRoot>/storage/media.
MEDIA_STORAGE_DIR=
